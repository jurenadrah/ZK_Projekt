# Copy this file to .env.mantis and replace the example values.
# Find the Session pooler host and username in Supabase:
# Project Settings -> Database -> Connect.
MANTIS_DB_HOST=your-project-ref.pooler.supabase.com
MANTIS_DB_PORT=5432
MANTIS_DB_NAME=postgres
MANTIS_DB_USER=postgres.your-project-ref
MANTIS_DB_PASSWORD=replace-with-your-database-password
MANTIS_CRYPTO_MASTER_SALT=replace-with-a-random-string-of-at-least-32-characters
